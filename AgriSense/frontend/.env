# api  : données du backend FastAPI (connexion requise)
# demo : données de démonstration locales, sans serveur
VITE_DATA_MODE=api
# Laisser /api/v1 en développement (proxy Vite vers http://127.0.0.1:8000).
# En production, mettre l'URL complète du backend, ex. https://mon-backend.tn/api/v1
VITE_API_URL=/api/v1
