# Copier ce fichier en .env puis remplir les valeurs. Ne jamais committer .env.
# Détail de chaque clé (où l'obtenir) : ../CONFIGURATION.md

# --- Base MySQL de l'application (utilisateurs, parcelles, analyses) ---
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=agrisense
MYSQL_USER=root
MYSQL_PASSWORD=123456

# Catalogue cultures MySQL (moteur d'indicateurs) : mêmes identifiants, autre base
CULTURE_MYSQL_DATABASE=nasa_challenge

APP_NAME=Adapting Farms API
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1

# --- Authentification ---
JWT_SECRET_KEY=Xp1FHx_VeUsR8-sw_oMz0KSI_CF72gZCs7tqyrLqUKiDuAdJn1siTvT8pxR7VKzF
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- Frontend autorisé (Vite) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Chatbot et explications IA (optionnel) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- Lecture des rapports de sol PDF/image (optionnel) ---
GCP_API_KEY=your_gcp_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Google Earth Engine (optionnel) ---
# Never paste key JSON/private-key contents here or commit the credential file.
GEE_PROJECT=nasa-challenge123456789
GEE_SERVICE_ACCOUNT= gee-service-account@nasa-challenge123456789.iam.gserviceaccount.com
GEE_KEY_FILE=C:/Users/ons sassi/nasa-challenge.json
